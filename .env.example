# Wingman Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file with real credentials to version control

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
LIGHTNING_API_KEY=your_lightning_api_key_here
LITELLM_API_KEY=your_optional_litellm_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# LLM Provider Selection (optional, defaults to groq)
# Supported values: groq, google, litai, litellm
LLM_PROVIDER=groq

# Model Names (optional, uses defaults if not specified)
GROQ_MODEL=groq/qwen2-7b-instruct
GOOGLE_MODEL=gemini-2.0-flash
LITAI_MODEL=google/gemini-2.5-flash-lite-preview-06-17
LITAI_API_BASE=https://lightning.ai/api/v1
LITELLM_MODEL=groq/qwen2-7b-instruct
# LITELLM_API_BASE=https://your-openai-compatible-endpoint/v1

# Database Configuration (optional)
WINGMAN_DB_PATH=dataset/wingmandb.db

# Telegram Authorization (optional, for /sendfile command)
TELEGRAM_ALLOWED_USER_IDS=123456789
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# External API Keys (only needed if using those services)
SERPER_API_KEY=your_serper_api_key_here
