# Wingman Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file with real credentials to version control

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
LIGHTNING_API_KEY=your_lightning_api_key_here
LITELLM_API_KEY=your_optional_litellm_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# LLM Provider Selection
# Supported values: groq, google, litai, litellm
LLM_PROVIDER=groq
GROQ_MODEL=groq/qwen/qwen3-32b
GOOGLE_MODEL=gemini-3-flash-preview
LITAI_MODEL=openai/gpt-4o
LITAI_API_BASE=https://lightning.ai/api/v1
LITELLM_MODEL=groq/qwen/qwen3-32b
# LITELLM_API_BASE=https://your-openai-compatible-endpoint/v1

# Google Calendar & Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Configuration
WINGMAN_DB_PATH=dataset/wingmandb.db

# Application Settings
DEBUG=false

# Zerodha Trading API (Optional - if using stock trading features)
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
